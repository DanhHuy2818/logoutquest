local function startLoop()
    if loopConn then loopConn:Disconnect() end
    local lastCheck = 0
    local lastUi = 0
    loopConn = RunService.Heartbeat:Connect(function()
        if STATE.destroyed then return end
        local now = tick()
        if STATE.running and now - lastCheck >= CHECK_INTERVAL then
            lastCheck = now
            updateLogic()
        end
        if now - lastUi >= UI_INTERVAL then
            lastUi = now
            updateUi()
        end
    end)
end

toggleBtn.MouseButton1Click:Connect(function()
    STATE.running = not STATE.running
    if STATE.running then
        toggleBtn.Text = "Stop"
        toggleBtn.BackgroundColor3 = Color3.fromRGB(150, 20, 20)
        refreshPaths()
        updateLogic()
        startLoop()
    else
        toggleBtn.Text = "Start"
        toggleBtn.BackgroundColor3 = Color3.fromRGB(0, 140, 60)
        updateUi()
    end
end)

closeBtn.MouseButton1Click:Connect(function()
    STATE.destroyed = true
    STATE.running = false
    if loopConn then loopConn:Disconnect() end
    gui:Destroy()
end)

refreshPaths()
pcall(readLiveData)
updateLogic()
updateUi()
startLoop()

if AUTOSTART == "true" then
    task.wait(2)
    STATE.running = true
    toggleBtn.Text = "Stop"
    toggleBtn.BackgroundColor3 = Color3.fromRGB(150, 20, 20)
end

print("[BF Logout v14] AutoKick=" .. AUTOKICK .. " AutoStart=" .. AUTOSTART)
