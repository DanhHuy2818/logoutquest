    PATH.expText = PATH.levelGui and PATH.levelGui:FindFirstChild("Exp") or nil

    local quest = PATH.main and PATH.main:FindFirstChild("Quest") or nil
    local container = quest and quest:FindFirstChild("Container") or nil
    local qTitleFrame = container and container:FindFirstChild("QuestTitle") or nil
    local qRewardFrame = container and container:FindFirstChild("QuestReward") or nil
    PATH.questTitle = qTitleFrame and qTitleFrame:FindFirstChild("Title") or nil
    PATH.questReward = qRewardFrame and qRewardFrame:FindFirstChild("Title") or nil
end

local function readBoost()
    local total = 0
    local levelGui = PATH.levelGui
    if not levelGui then return 0 end

    for _, frameName in ipairs({"FriendBoost", "ExploreBoost"}) do
        local frame = levelGui:FindFirstChild(frameName)
        local best = 0
        if frame and visible(frame) then
            for _, obj in ipairs(frame:GetDescendants()) do
                local text = readText(obj)
                if text then
                    local p = tonumber(text:match("([%+%-]?%d+)%%"))
                    if p and p > best then best = p end
                end
            end
        end
        total = total + best
    end

    return math.max(0, total / 100)
end

local function readLiveData()
    local level = tonumber(readValue(PATH.dataLevel))
    if not level then
        local lvText = readText(PATH.levelGui)
        level = lvText and tonumber(lvText:match("Lv%.?%s*(%d+)")) or nil
    end
    if level and level >= 1 and level <= MAX_LEVEL then
        DATA.level = level
    end

    local expText = readText(PATH.expText)
    local cur, max, has2x, remain = parseExpBar(expText)
    if not cur then cur = tonumber(readValue(PATH.dataExp)) end
    if DATA.level and not max then max = expNeeded(DATA.level) end

    if cur then
        if DATA.lastExpCur and DATA.lastLevel == DATA.level then
            local diff = cur - DATA.lastExpCur
            if diff > 0 and (not DATA.questExp or diff < DATA.questExp * 0.45) then
                DATA.lastMobGain = math.max(DATA.lastMobGain or 0, diff)
            elseif diff < 0 then
                DATA.lastMobGain = 0
            end
        end
        DATA.expCur = cur
        DATA.lastExpCur = cur
        DATA.lastLevel = DATA.level
    end
    if max and max > 0 then DATA.expMax = max end
    DATA.is2x = has2x
    DATA.x2Remain = remain or 0
    DATA.boost = readBoost()

    local qTitle = readText(PATH.questTitle)
    local qReward = readText(PATH.questReward)
    if PATH.questTitle and PATH.questReward and visible(PATH.questTitle) and visible(PATH.questReward) then
        DATA.questTitle = (qTitle and qTitle:gsub("\n", " ")) or "--"
        DATA.questDone, DATA.questTotal = parseQuestProgress(qTitle)
        DATA.questExp = parseQuestReward(qReward)
    else
        DATA.questTitle = "--"
        DATA.questDone = nil
        DATA.questTotal = nil
        DATA.questExp = nil
    end

    if DATA.lastQuestTitle ~= DATA.questTitle then
        DATA.lastQuestTitle = DATA.questTitle
        DATA.lastMobGain = 0
    end
end

local function expToMilestone(level, cur, max, milestone)
    if not (level and cur and max and milestone) then return nil end
    local need = math.max(0, max - cur)
    for lv = level + 1, milestone - 1 do
        need = need + expNeeded(lv)
    end
    return math.floor(need)
end

local function totalGainIfQuestDone()
    local questExp = DATA.questExp
    if not questExp then return nil end

    local mult = DATA.is2x and 2 or 1
    mult = mult + (DATA.boost or 0)

    local rewardGain = math.floor(questExp * mult)
    local remainingMob = 0
    if DATA.questDone and DATA.questTotal and DATA.lastMobGain and DATA.lastMobGain > 0 then
        local left = math.max(0, DATA.questTotal - DATA.questDone)
        remainingMob = DATA.lastMobGain * left
    end
    return rewardGain + remainingMob
end

local function simulateAfter(level, cur, max, gain)
    if not (level and cur and max and gain) then return nil end
    local lv = level
    local rem = cur + gain
    local need = max
    local guard = 0
    while rem >= need and lv < MAX_LEVEL and guard < 500 do
        rem = rem - need
        lv = lv + 1
        need = expNeeded(lv)
        guard = guard + 1
    end
    return lv
end

