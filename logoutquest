local function safe(fn)
    local ok, res = pcall(fn)
    if ok then return res end
    return nil
end

local function readText(obj)
    if not obj then return nil end
    local v = safe(function() return obj.Text end)
    if v == nil then return nil end
    return tostring(v)
end

local function readValue(obj)
    if not obj then return nil end
    return safe(function() return obj.Value end)
end

local function visible(obj)
    if not obj then return false end
    local cur = obj
    while cur and cur ~= game do
        local v = safe(function() return cur.Visible end)
        if v == false then return false end
        cur = cur.Parent
    end
    return true
end

local function num(raw)
    if raw == nil then return nil end
    local s = tostring(raw)
    s = s:gsub(",", "")
    s = s:gsub("%s", "")
    local suffix = s:match("([KkMmBb])")
    local mul = 1
    if suffix then
        suffix = suffix:lower()
        if suffix == "k" then mul = 1000 end
        if suffix == "m" then mul = 1000000 end
        if suffix == "b" then mul = 1000000000 end
    end
    local cleaned = s:gsub("[^%d%.%-]", "")
    local n = tonumber(cleaned)
    if not n then return nil end
    return math.floor(n * mul)
end

local function fmt(n)
    n = tonumber(n)
    if not n then return "--" end
    if n >= 1000000 then return string.format("%.2fM", n / 1000000) end
    if n >= 1000 then return string.format("%.1fK", n / 1000) end
    return tostring(math.floor(n))
end

local function fmtTime(s)
    s = tonumber(s) or 0
    if s <= 0 then return "--" end
    s = math.floor(s)
    local h = math.floor(s / 3600)
    local m = math.floor((s % 3600) / 60)
    local sec = s % 60
    if h > 0 then return string.format("%dh%02dm", h, m) end
    if m > 0 then return string.format("%dm%02ds", m, sec) end
    return tostring(sec) .. "s"
end

local function expNeeded(level)
    level = tonumber(level) or 1
    return math.floor((2 * (level ^ 2.3)) + 84)
end

local function nextMilestone(level)
    if not level then return nil end
    for _, m in ipairs(MILESTONES) do
        if m > level then return m end
    end
    return nil
end

local function parse2xTime(text)
    text = tostring(text or "")
    local d, h, m, s = text:match("(%d+):(%d+):(%d+):(%d+)")
    if d then return tonumber(d) * 86400 + tonumber(h) * 3600 + tonumber(m) * 60 + tonumber(s) end
    h, m, s = text:match("(%d+):(%d+):(%d+)")
    if h then return tonumber(h) * 3600 + tonumber(m) * 60 + tonumber(s) end
    m, s = text:match("(%d+):(%d+)")
    if m then return tonumber(m) * 60 + tonumber(s) end
    return 0
end

local function parseExpBar(text)
    if not text then return nil, nil, false, 0 end
    text = tostring(text)
    local a, b = text:match("([%d,%.]+)%s*/%s*([%d,%.]+)")
    local cur = num(a)
    local max = num(b)
    local low = text:lower()
    local has2x = low:find("2x") ~= nil and low:find("ends") ~= nil
    local remain = has2x and parse2xTime(text) or 0
    return cur, max, has2x, remain
end

local function parseQuestProgress(text)
    if not text then return nil, nil end
    local done, total = tostring(text):match("%((%d+)%s*/%s*(%d+)%)")
    return tonumber(done), tonumber(total)
end

local function parseQuestReward(text)
    if not text then return nil end
    text = tostring(text)
    local best = nil
    for raw in text:gmatch("([%d][%d,%.]*)%s*[Ee][Xx][Pp]%.?") do
        local v = num(raw)
        if v and (not best or v > best) then best = v end
    end
    if not best then
        for raw in text:gmatch("([%d][%d,%.]*)%s*Experience") do
            local v = num(raw)
            if v and (not best or v > best) then best = v end
        end
    end
    return best
end

local function refreshPaths()
