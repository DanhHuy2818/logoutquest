local resizing = false
local resizeStartMouse = nil
local resizeStartScale = nil
local resizeInput = nil
local loopConn = nil

local function beginResize(pos, input)
    resizing = true
    resizeStartMouse = pos
    resizeStartScale = panelScale.Scale
    resizeInput = input
end

resize.MouseButton1Down:Connect(function()
    beginResize(UIS:GetMouseLocation(), nil)
end)

resize.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch then
        beginResize(Vector2.new(input.Position.X, input.Position.Y), input)
    end
end)

UIS.InputChanged:Connect(function(input)
    if not resizing then return end
    if input.UserInputType == Enum.UserInputType.MouseMovement or input == resizeInput then
        local pos = input.UserInputType == Enum.UserInputType.MouseMovement
            and UIS:GetMouseLocation()
            or Vector2.new(input.Position.X, input.Position.Y)
        local dx = (pos.X - resizeStartMouse.X) / 220
        local dy = (pos.Y - resizeStartMouse.Y) / 280
        local delta = math.abs(dx) > math.abs(dy) and dx or dy
        panelScale.Scale = math.clamp(resizeStartScale + delta, 0.55, 1.35)
    end
end)

UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input == resizeInput then
        resizing = false
        resizeInput = nil
    end
end)

local lastPathRefresh = 0
local function updateLogic()
    local now = tick()
    if now - lastPathRefresh >= PATH_REFRESH_INTERVAL then
        lastPathRefresh = now
        refreshPaths()
    end

    local ok, err = pcall(readLiveData)
    if not ok then
        STATE.source = "Read error"
        STATE.alert = tostring(err):sub(1, 80)
        STATE.safe = true
        return
    end

    local lv = DATA.level
    local cur = DATA.expCur
    local max = DATA.expMax
    local milestone = nextMilestone(lv)
    local gain = totalGainIfQuestDone()
    local need = expToMilestone(lv, cur, max, milestone)
    local after = simulateAfter(lv, cur, max, gain or 0)

    STATE.pct = (cur and max and max > 0) and math.clamp(cur / max, 0, 1) or 0
    STATE.gain = gain
    STATE.need = need
    STATE.afterLevel = after and ("Lv." .. tostring(after)) or "--"

    if not lv then
        STATE.source = "No level"
        STATE.alert = "Missing level"
        STATE.safe = true
        return
    end
    if not cur or not max then
        STATE.source = "No EXP"
        STATE.alert = "Missing EXP bar"
        STATE.safe = true
        return
    end
    if not milestone then
        STATE.source = "Max"
        STATE.alert = "Max level"
        STATE.safe = true
        return
    end
    if not DATA.questExp then
        STATE.source = "No quest"
        STATE.alert = "Waiting current quest"
        STATE.safe = true
        return
    end

    if gain and need and gain >= need then
        STATE.source = "STOP"
        STATE.alert = "Done quest se qua moc " .. tostring(milestone)
        STATE.safe = false
        if AUTOKICK == "true" and STATE.running then
            STATE.running = false
            task.spawn(kickNow)
        end
    else
        STATE.source = "OK"
        STATE.alert = "Safe - farm tiep"
        STATE.safe = true
    end
end

